---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { approaches, type ApproachPage } from '../../data/approaches';
import { approachExplanations } from '../../data/approach-explanations';
import ApproachExplainer from '../../components/ApproachExplainer.astro';

export function getStaticPaths() {
  return approaches.map((approach) => ({
    params: { slug: approach.slug },
    props: { approach },
  }));
}

type Props = { approach: ApproachPage };
const { approach } = Astro.props;
const explanation = approachExplanations[approach.slug];
if (!explanation) throw new Error(`Missing explanation for approach: ${approach.slug}`);
const nextHref = approach.next ? `/approach/${approach.next.slug}/` : '/#approach';
---

<BaseLayout
  title={`${approach.keyword} | ${approach.title} | LVNS SPACE PROJECT`}
  description={approach.catchphrase}
  image={approach.image}
>
  <main class="approach-detail">
    <section class="approach-detail__hero section-gray" aria-labelledby="approach-detail-title">
      <div class="content-inner approach-detail__hero-inner">
        <div class="approach-detail__copy">
          <a class="back-link" href="/#approach">← ALL APPROACHES</a>
          <p class="approach-detail__index">{approach.number} <span>/</span> {approach.keyword}</p>
          <h1 id="approach-detail-title">{approach.title}</h1>
          <h2>{approach.catchphrase}</h2>
          <div class="approach-detail__lead">
            {approach.lead.map((paragraph) => <p>{paragraph}</p>)}
            <p class="approach-detail__emphasis"><strong>{approach.emphasis}</strong></p>
          </div>
        </div>
      </div>
    </section>

    <section class="approach-detail__explainer section-gray" aria-labelledby="approach-explainer-title">
      <div class="content-inner">
        <ApproachExplainer explanation={explanation} />
      </div>
    </section>

    <section class="approach-detail__process" aria-labelledby="process-title">
      <div class="content-inner">
        <p class="eyebrow">HOW WE PROCEED</p>
        <h2 class="section-title" id="process-title">PROCESS</h2>
        <ol class="approach-process">
          {approach.process.map((step, index) => (
            <li class="approach-process__item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="approach-detail__examples section-gray" aria-labelledby="examples-title">
      <div class="content-inner">
        <p class="eyebrow">IN PRACTICE</p>
        <h2 class="section-title" id="examples-title">{approach.examplesTitle}</h2>
        <ul class="approach-examples">
          {approach.examples.map((example, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{example}</strong></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="approach-detail__closing" aria-label="ページ末尾メッセージ">
      <div class="content-inner">
        <p>{approach.closing}</p>
        {approach.next ? (
          <a class="approach-detail__next" href={nextHref}>
            <span>NEXT APPROACH</span>
            <strong>{approach.next.number} / {approach.next.keyword}</strong>
            <em>{approach.next.title}</em>
            <i aria-hidden="true">↗</i>
          </a>
        ) : (
          <div class="approach-detail__model">
            <span>LVNS SPACE PROJECT</span>
            <strong>宇宙で工学を発見し、地球で工業にする。</strong>
            <a href={nextHref}>ALL APPROACHES <i aria-hidden="true">↗</i></a>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

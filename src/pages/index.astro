---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const visibleNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const approaches = [
  {
    number: '01',
    name: '研究テーマ創出',
    catchphrase: '宇宙だからこそ挑戦する「問い」をつくる。',
    description: '企業と研究者をつなぎ、宇宙を使うからこそ生まれる新しい問いをつくります。',
    flow: 'QUESTION',
  },
  {
    number: '02',
    name: '宇宙実験アクセス基盤',
    catchphrase: '研究に最適な「宇宙への行き方」をつくる。',
    description: '研究目的に合わせて、最適な宇宙実験機会を設計し、宇宙を使える状態をつくります。',
    flow: 'ACCESS',
  },
  {
    number: '03',
    name: '宇宙実験基盤創出',
    catchphrase: '宇宙で「できる実験」を増やす。',
    description: '装置や実験方法を宇宙環境へ対応させ、宇宙でできる研究の種類を増やします。',
    flow: 'EXPERIMENT',
  },
  {
    number: '04',
    name: '価値基準創出',
    catchphrase: '宇宙から、新しい「価値のものさし」をつくる。',
    description: '宇宙の発見から評価方法や基準をつくり、地球の新しい価値へ変換します。',
    flow: 'VALUE',
  },
];
---

<BaseLayout>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__slides" aria-hidden="true">
      <div class="hero__slide hero__slide--a"></div>
      <div class="hero__slide hero__slide--b"></div>
      <div class="hero__slide hero__slide--c"></div>
    </div>
    <a class="language-tab" href="#top">English</a>
    <div class="hero__content">
      <div class="hero__title-panel">
        <h1 id="hero-title">LVNS SPACE PROJECT</h1>
      </div>
      <p class="hero__organizer">Organized by Leave a Nest</p>
      <p class="hero__tagline">Discover Engineering Beyond Gravity</p>
    </div>
    <a class="scroll-cue" href="#about"><span>SCROLL</span><i></i></a>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="content-inner">
      <div class="about__heading">
        <p class="eyebrow">WHY SPACE RESEARCH</p>
        <h2 class="section-title" id="about-title">ABOUT</h2>
        <p class="about__question">なぜ、宇宙に研究所をつくるのか。</p>
      </div>
      <div class="about-layout">
        <div class="about-copy">
          <p>私たちの研究やものづくりは、これまで地球という環境の中で発展してきました。</p>
          <p>重力があり、大気があり、一定の温度や圧力がある。<br />私たちは、そうした条件を「当たり前」として、材料をつくり、細胞を育て、結晶を成長させ、さまざまな技術を生み出してきました。</p>
          <p>けれど、その前提を変えたらどうなるでしょうか。</p>
          <p>重力がほとんどない。<br />真空がある。<br />放射線環境が違う。<br />地上とはまったく異なる熱や流体の挙動が現れる。</p>
          <p>宇宙には、地球上では簡単につくることのできない研究環境があります。</p>
          <p>私たちは、宇宙を「遠くへ行く場所」ではなく、<strong>新しい発見を生み出す研究環境</strong>として捉えています。</p>
          <p>地球で積み重ねてきた研究を、そのまま宇宙へ持っていくのではありません。</p>
          <p>宇宙という異なる環境に研究を置くことで、これまで見えなかった現象や、新しい原理、新しいプロセスを発見する。</p>
          <p>その発見を地球へ持ち帰り、次の研究、技術、産業へつなげていく。</p>
          <p>そのために、私たちは研究テーマを生み出し、宇宙へアクセスする方法を整え、実験装置をつくり、成果を価値へ変える仕組みまで含めた「研究所」を宇宙につくろうとしています。</p>
          <p class="about-copy__closing"><strong>研究開発の選択肢に、宇宙を加える。</strong><br />それが、LVNS SPACE PROJECTの出発点です。</p>
        </div>

        <div class="about-visual" aria-label="地球の研究環境から宇宙の研究環境へ変える流れを示す線画">
          <svg class="about-illustration" viewBox="0 0 680 680" role="img" aria-labelledby="about-illustration-title about-illustration-desc">
            <title id="about-illustration-title">地球の研究環境から宇宙の研究環境へ</title>
            <desc id="about-illustration-desc">地上の研究アイコンを囲むEARTHから軌道線がSPACE LABへ伸び、条件を変えることで新しい工学を発見する流れを表しています。</desc>
            <defs>
              <pattern id="about-blueprint-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-width=".5" />
              </pattern>
              <filter id="about-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
            </defs>
            <rect class="about-illustration__grid" x="18" y="18" width="644" height="644" rx="10" />
            <path class="about-illustration__frame" d="M18 70V28h42M620 28h42v42M662 610v42h-42M60 652H18v-42" />

            <g class="about-illustration__conditions about-illustration__conditions--earth">
              <text x="34" y="92">EARTH</text>
              <text x="34" y="112">地球の条件</text>
              <text x="34" y="145">GRAVITY　重力</text>
              <text x="34" y="166">ATMOSPHERE　大気</text>
              <text x="34" y="187">CONVECTION　対流</text>
              <text x="34" y="208">SEDIMENTATION　沈降</text>
            </g>

            <g class="about-illustration__conditions about-illustration__conditions--space">
              <text x="442" y="390">SPACE</text>
              <text x="442" y="410">宇宙の条件</text>
              <text x="442" y="443">MICROGRAVITY　微小重力</text>
              <text x="442" y="464">VACUUM　真空</text>
              <text x="442" y="485">RADIATION　放射線</text>
              <text x="442" y="506">DIFFERENT FLUID BEHAVIOR</text>
              <text x="442" y="522">異なる流体挙動</text>
            </g>

            <g class="about-illustration__earth about-illustration__element">
              <circle cx="150" cy="500" r="82" />
              <path d="M82 475c24-16 39-13 53-26 16-15 28-11 38 3 9 12 22 8 34 23 10 12 20 15 25 26M91 527c18-5 29 5 43 17 14 12 27 12 39 2 16-14 23-15 42-10M140 421c-9 20-5 34 7 44 12 10 10 24 3 35-10 15-10 31 3 46 9 11 10 21 7 33" />
              <path d="M76 500h148M150 418c-26 22-37 51-37 82s11 60 37 82M150 418c26 22 37 51 37 82s-11 60-37 82" />
              <text x="105" y="610">EARTH</text>
            </g>

            <g class="about-illustration__research about-illustration__element" aria-hidden="true">
              <g transform="translate(56 292)">
                <path d="M18 3v19l-10 15a5 5 0 0 0 4 8h22a5 5 0 0 0 4-8L28 22V3M13 28h20M16 3h14" />
                <circle cx="41" cy="7" r="2" />
                <text x="0" y="61">MATERIALS</text>
              </g>
              <g transform="translate(188 286)">
                <path d="M4 12h23M9 12v17M22 12v17M6 29h19M11 7h10l4 5H7zM16 7V2" />
                <circle cx="16" cy="2" r="2" />
                <path d="M7 35h18" />
                <text x="-2" y="54">CELLS</text>
              </g>
              <g transform="translate(243 552)">
                <path d="m18 2 15 8v18l-15 8L3 28V10zM18 2v18m15-10-15 8L3 10M18 20v16" />
                <text x="-1" y="54">CRYSTAL</text>
              </g>
              <g transform="translate(39 559)">
                <path d="M6 5c7 10 14 13 28 15-9 8-21 8-30 1 5-5 6-10 2-16zM4 36h34M20 21v15" />
                <path d="M36 10c6 4 8 8 8 15" />
                <text x="-2" y="54">FLUID</text>
              </g>
              <g transform="translate(235 423)">
                <path d="M4 37h33M9 37V14h23v23M14 14V7h14v7M14 23h14M14 29h14" />
                <path d="M4 44h33" />
                <text x="-2" y="62">LAB</text>
              </g>
            </g>

            <path class="about-illustration__orbit about-illustration__line" d="M72 528C170 339 273 257 405 214c90-29 171-17 213 33" />
            <path class="about-illustration__orbit about-illustration__orbit--secondary" d="M84 564C222 393 306 318 438 264c76-31 137-29 176 3" />
            <path class="about-illustration__arrow" d="m601 239 18 5-10 16" />

            <g class="about-illustration__change about-illustration__element">
              <rect x="245" y="78" width="190" height="76" rx="3" />
              <text x="340" y="107" text-anchor="middle">CHANGE THE CONDITIONS</text>
              <text x="340" y="134" text-anchor="middle">前提を変える。</text>
            </g>

            <g class="about-illustration__lab about-illustration__element">
              <rect x="474" y="164" width="112" height="74" rx="4" />
              <path d="M474 181h112M474 220h112M496 164v74M562 164v74" />
              <rect x="507" y="190" width="43" height="22" rx="2" />
              <circle cx="518" cy="201" r="6" />
              <path d="M552 194v15M542 197h20M449 182h25M586 182h26M451 226h23M586 226h26" />
              <path d="M417 154h32v18h-32zM417 229h32v18h-32z" />
              <path d="m398 163 19 0M398 238l19 0" />
              <circle cx="404" cy="163" r="3" /><circle cx="404" cy="238" r="3" />
              <text x="530" y="266" text-anchor="middle">SPACE LAB</text>
              <text x="530" y="285" text-anchor="middle">軌道上の研究室</text>
            </g>

            <g class="about-illustration__discovery about-illustration__element">
              <path d="M452 572h150M452 585h150" />
              <text x="452" y="548">DISCOVER NEW ENGINEERING</text>
              <text x="452" y="620">新しい工学を発見する。</text>
              <circle cx="625" cy="550" r="13" filter="url(#about-glow)" />
              <path d="M625 530v40M605 550h40" />
            </g>
            <text class="about-illustration__flow-label" x="326" y="347" text-anchor="middle">RESEARCH</text>
            <text class="about-illustration__flow-label" x="326" y="368" text-anchor="middle">CHANGE THE ENVIRONMENT</text>
            <text class="about-illustration__flow-label" x="326" y="389" text-anchor="middle">DISCOVERY</text>
          </svg>
        </div>
      </div>
      <div class="about-bridge">
        <p>もし、研究の前提を変えることができたら。<br />まだ見つかっていない工学を、発見できるかもしれない。</p>
        <a href="#vision" class="about-bridge__link"><span>VISION</span><strong>宇宙を使って、延長線上にない工学を発見する。</strong><i aria-hidden="true">↓</i></a>
      </div>
    </div>
  </section>

  <section class="vision section-gray" id="vision" aria-labelledby="vision-title">
    <div class="content-inner">
      <p class="eyebrow">OUR VISION</p>
      <h2 class="section-title" id="vision-title">VISION</h2>
      <p class="vision__lead">宇宙を使って、延長線上にない工学を発見する。</p>
      <div class="vision__body">
        <p>私たちの工学は、地球という環境の中で発展してきました。<br />重力があり、大気があり、地上で利用できる材料やエネルギーがある。その「当たり前」の条件の中で、さまざまな技術が生まれてきました。</p>
        <p>では、その前提を変えたら、どのような工学が生まれるでしょうか。</p>
        <p>微小重力、真空、放射線、極端な温度差など、宇宙には地球とは異なる環境があります。LVNS SPACE PROJECTは、宇宙を単なる「行く場所」ではなく、<strong>地球ではつくることのできない研究環境</strong>として捉えます。</p>
        <p>地上の技術をそのまま宇宙へ持っていくのではなく、宇宙だからこそ観察できる現象、宇宙だからこそ成立する実験から、これまでの技術開発の延長線上にはない原理や方法を見つけ出す。</p>
        <p>そして、そこで発見した新しい工学を地球へ持ち帰り、新しい産業や社会の可能性につなげていく。</p>
        <p><strong>宇宙を使って、延長線上にない工学を発見する。</strong>それが、LVNS SPACE PROJECTのVISIONです。</p>
      </div>
    </div>
  </section>

  <section class="approach section-black" id="approach" aria-labelledby="approach-title">
    <div class="content-inner">
      <p class="eyebrow eyebrow--light">WHAT WE DO</p>
      <h2 class="section-title section-title--light" id="approach-title">APPROACH</h2>
      <p class="approach__subtitle">宇宙を研究開発のフィールドにする、4つのアプローチ</p>
      <div class="approach__intro">
        <p>LVNS SPACE PROJECTは、宇宙へ実験を持っていくだけのプロジェクトではありません。</p>
        <p>研究テーマを生み出し、宇宙へアクセスする方法をつくり、実験できる環境を整え、そこで得られた成果を新しい価値へ変えていく。</p>
        <p><strong>「宇宙を使って、延長線上にない工学を発見する」ために、4つのアプローチから研究開発の仕組みそのものをつくります。</strong></p>
      </div>
      <div class="approach-grid">
        {approaches.map((approach, index) => (
          <article class="approach-card">
            <div class="approach-card__topline">
              <p class="approach-card__number">{approach.number}</p>
              <span class="approach-card__flow">{approach.flow}</span>
            </div>
            <div class="approach-card__icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M10 2v5.2l-4.6 7.2A3 3 0 0 0 7.9 19h8.2a3 3 0 0 0 2.5-4.6L14 7.2V2" />
                  <path d="M8 10h8M10 2h4" />
                  <path d="M18.5 4.2c0-1.1.8-2 1.9-2s1.9.7 1.9 1.7c0 1.3-1.9 1.5-1.9 2.8" />
                  <circle cx="20.4" cy="8.5" r=".5" fill="currentColor" stroke="none" />
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24" role="img">
                  <circle cx="12" cy="12" r="4.6" />
                  <path d="M3 12h18M12 3c2.3 2.4 3.5 5.4 3.5 9S14.3 18.6 12 21M12 3c-2.3 2.4-3.5 5.4-3.5 9s1.2 6.6 3.5 9" />
                  <path d="M2.5 8.2c4.8-4 12.4-4.4 18.8-.5" />
                  <path d="m18.8 5.4 2.5 2.3-3.3.3" />
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24" role="img">
                  <rect x="8" y="8" width="8" height="8" rx="1" />
                  <path d="M5 9H2v6h3M19 9h3v6h-3M10 5V2h4v3M10 19v3h4v-3M10.5 11h3M10.5 13h3" />
                  <path d="M5 12h3M16 12h3" />
                </svg>
              )}
              {index === 3 && (
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M4 18V9M8 18v-5M12 18V6M16 18v-8M20 18V3" />
                  <path d="M3 18h18M3 21h18" />
                  <circle cx="12" cy="12" r="3.6" />
                  <path d="M8.6 12h6.8M12 8.4c1.2 1 1.8 2.2 1.8 3.6S13.2 14.6 12 15.6M12 8.4c-1.2 1-1.8 2.2-1.8 3.6s.6 2.6 1.8 3.6" />
                </svg>
              )}
            </div>
            <h3>{approach.name}</h3>
            <p class="approach-card__catch">{approach.catchphrase}</p>
            <p class="approach-card__description">{approach.description}</p>
          </article>
        ))}
      </div>
      <div class="approach-flow" aria-label="4つのアプローチをつなぐ循環">
        <p class="approach-flow__label">4つのアプローチをつなぐ</p>
        <div class="approach-flow__steps">
          {approaches.map((approach, index) => (
            <div class="approach-flow__step">
              <span>{approach.flow}</span>
              <strong>{['問いをつくる', '宇宙へつなぐ', '実験できるようにする', '価値に変える'][index]}</strong>
              {index < approaches.length - 1 && <i aria-hidden="true">→</i>}
            </div>
          ))}
        </div>
        <p class="approach-flow__result">新しい研究テーマ・産業へ</p>
        <p class="approach-flow__tagline">宇宙で工学を発見し、地球で工業にする。</p>
      </div>
    </div>
  </section>

  <section class="news-section" id="news" aria-labelledby="news-title">
    <div class="content-inner">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">LATEST UPDATES</p>
          <h2 class="section-title" id="news-title">NEWS</h2>
        </div>
        <a class="text-link" href="/news/">VIEW ALL <span>↗</span></a>
      </div>
      {visibleNews.length > 0 ? (
        <div class="news-grid">
          {visibleNews.map((post) => (
            <article class="news-card">
              <a href={'/news/' + post.id + '/'}>
                <div class="news-card__image-wrap">
                  <img src={post.data.heroImage} alt="" class="news-card__image" loading="lazy" />
                </div>
                <div class="news-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ja-JP')}</time>
                  {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">ニュースは準備中です。</p>
      )}
    </div>
  </section>

  <section class="partner section-gray" id="partner" aria-labelledby="partner-title">
    <div class="content-inner">
      <p class="eyebrow">OUR PARTNERS</p>
      <h2 class="section-title" id="partner-title">PARTNER</h2>
      <p class="partner__lead">宇宙の未来を、ともにつくる。</p>
      <div class="partner-note">
        <p>LVNS SPACE PROJECTは、宇宙を起点とした新しい挑戦に取り組むパートナーを募集しています。</p>
        <a class="text-link" href="mailto:space@lnest.jp">PARTNER WITH US <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="contact__overlay"></div>
    <div class="content-inner contact__inner">
      <p class="eyebrow eyebrow--light">GET IN TOUCH</p>
      <h2 class="section-title section-title--light" id="contact-title">CONTACT</h2>
      <p>お問い合わせ</p>
      <a class="contact__button" href="mailto:space@lnest.jp">space@lnest.jp <span>↗</span></a>
    </div>
  </section>
</BaseLayout>

<script>
  const aboutSection = document.querySelector('.about');
  if (aboutSection && 'IntersectionObserver' in window) {
    const aboutObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          aboutSection.classList.add('about--visible');
          aboutObserver.disconnect();
        }
      },
      { threshold: 0.18 },
    );
    aboutObserver.observe(aboutSection);
  }
</script>

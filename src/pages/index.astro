---
import { getCollection } from 'astro:content';
import ApproachOverview from '../components/ApproachOverview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const visibleNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const approachCards = [
  {
    slug: 'question',
    number: '01',
    icon: 'question' as const,
    name: '研究テーマ創出',
    catchphrase: '宇宙だからこそ挑戦する「問い」をつくる。',
    description: '企業と研究者をつなぎ、宇宙を使うからこそ生まれる新しい問いをつくります。',
    flow: 'QUESTION',
  },
  {
    slug: 'access',
    number: '02',
    icon: 'access' as const,
    name: '実験アクセス基盤構築',
    catchphrase: '研究に最適な「宇宙への行き方」をつくる。',
    description: '研究目的に合わせて、最適な宇宙実験機会を設計し、宇宙を使える状態をつくります。',
    flow: 'ACCESS',
  },
  {
    slug: 'experiment',
    number: '03',
    icon: 'experiment' as const,
    name: '宇宙機器開発',
    catchphrase: '宇宙で「できる実験」を増やす。',
    description: '装置や実験方法を宇宙環境へ対応させ、宇宙でできる研究の種類を増やします。',
    flow: 'EXPERIMENT',
  },
  {
    slug: 'value',
    number: '04',
    icon: 'value' as const,
    name: '価値基準創出',
    catchphrase: '宇宙から、新しい「価値のものさし」をつくる。',
    description: '宇宙の発見から評価方法や基準をつくり、地球の新しい価値へ変換します。',
    flow: 'VALUE',
  },
];
---

<BaseLayout>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__slides" aria-hidden="true">
      <div class="hero__slide hero__slide--a"></div>
      <div class="hero__slide hero__slide--b"></div>
      <div class="hero__slide hero__slide--c"></div>
    </div>
    <a class="language-tab" href="/en/" lang="en">English</a>
    <div class="hero__content">
      <div class="hero__title-panel">
        <h1 id="hero-title">LVNS SPACE PROJECT</h1>
      </div>
      <p class="hero__organizer">Organized by Leave a Nest</p>
      <p class="hero__tagline">Discover Engineering Beyond Gravity</p>
    </div>
    <a class="scroll-cue" href="#vision"><span>SCROLL</span><i></i></a>
  </section>

  <section class="vision section-gray" id="vision" aria-labelledby="vision-title">
    <div class="content-inner">
      <p class="eyebrow">OUR VISION</p>
      <h2 class="section-title" id="vision-title">VISION</h2>
      <p class="vision__lead">宇宙を使って、延長線上にない工学を発見する。</p>
      <div class="vision__body">
        <p>私たちの工学は、地球という環境の中で発展してきました。<br />重力があり、大気があり、地上で利用できる材料やエネルギーがある。その「当たり前」の条件の中で、さまざまな技術が生まれてきました。</p>
        <p>では、その前提を変えたら、どのような工学が生まれるでしょうか。</p>
        <p>微小重力、真空、放射線、極端な温度差など、宇宙には地球とは異なる環境があります。LVNS SPACE PROJECTは、宇宙を単なる「行く場所」ではなく、<strong>地球ではつくることのできない研究環境</strong>として捉えます。</p>
        <p>地上の技術をそのまま宇宙へ持っていくのではなく、宇宙だからこそ観察できる現象、宇宙だからこそ成立する実験から、これまでの技術開発の延長線上にはない原理や方法を見つけ出す。</p>
        <p>そして、そこで発見した新しい工学を地球へ持ち帰り、新しい産業や社会の可能性につなげていく。</p>
        <p><strong>宇宙を使って、延長線上にない工学を発見する。</strong>それが、LVNS SPACE PROJECTのVISIONです。</p>
      </div>
    </div>
  </section>

  <ApproachOverview
    locale="ja"
    sectionLabel="WHAT WE DO"
    title="APPROACH"
    subtitle="宇宙を研究開発のフィールドにする、4つのアプローチ"
    intro={[
      'LVNS SPACE PROJECTは、宇宙へ実験を持っていくだけのプロジェクトではありません。',
      '研究テーマを生み出し、宇宙へアクセスする方法をつくり、実験できる環境を整え、そこで得られた成果を新しい価値へ変えていく。',
    ]}
    emphasis="「宇宙を使って、延長線上にない工学を発見する」ために、4つのアプローチから研究開発の仕組みそのものをつくります。"
    cards={approachCards}
    missionTitle={['宇宙に', '研究所をつくる']}
    missionLead={['研究開発の選択肢に、', '宇宙を加える。']}
    flowLabel="4つのアプローチをつなぐ"
    flowLabels={['問いをつくる', '宇宙へつなぐ', '実験できるようにする', '価値に変える']}
    flowResult="新しい研究テーマ・産業へ"
    tagline="宇宙で工学を発見し、地球で工業にする。"
  />

  <section class="news-section" id="news" aria-labelledby="news-title">
    <div class="content-inner">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">LATEST UPDATES</p>
          <h2 class="section-title" id="news-title">NEWS</h2>
        </div>
        <a class="text-link" href="/news/">VIEW ALL <span>↗</span></a>
      </div>
      {visibleNews.length > 0 ? (
        <div class="news-grid">
          {visibleNews.map((post) => (
            <article class="news-card">
              <a href={'/news/' + post.id + '/'}>
                <div class="news-card__image-wrap">
                  <img src={post.data.heroImage} alt="" class="news-card__image" loading="lazy" />
                </div>
                <div class="news-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ja-JP')}</time>
                  {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">ニュースは準備中です。</p>
      )}
    </div>
  </section>

  <section class="partner section-gray" id="partner" aria-labelledby="partner-title">
    <div class="content-inner">
      <p class="eyebrow">OUR PARTNERS</p>
      <h2 class="section-title" id="partner-title">PARTNER</h2>
      <p class="partner__lead">宇宙の未来を、ともにつくる。</p>
      <div class="partner-groups">
        <section class="partner-group" aria-labelledby="operating-partners-title">
          <div class="partner-group__heading">
            <p class="partner-group__eyebrow">OPERATING PARTNERS</p>
            <h3 id="operating-partners-title">運営パートナー</h3>
          </div>
          <div class="partner-grid">
            <article class="partner-card">
              <div class="partner-card__logo partner-card__logo--iddk"><img src="/images/partners/iddk.jpg" alt="株式会社IDDK" loading="lazy" /></div>
              <div class="partner-card__body">
                <p class="partner-card__role">OPERATING PARTNER</p>
                <h4>株式会社IDDK</h4>
              </div>
            </article>
            <article class="partner-card">
              <div class="partner-card__logo"><img src="/images/partners/space-nome-lab.png" alt="株式会社スペースノーム研究所" loading="lazy" /></div>
              <div class="partner-card__body">
                <p class="partner-card__role">OPERATING PARTNER</p>
                <h4>株式会社スペースノーム研究所</h4>
              </div>
            </article>
          </div>
        </section>
        <section class="partner-group" aria-labelledby="development-partners-title">
          <div class="partner-group__heading">
            <p class="partner-group__eyebrow">DEVELOPMENT PARTNER</p>
            <h3 id="development-partners-title">開発パートナー</h3>
          </div>
          <div class="partner-grid partner-grid--single">
            <div class="partner-coming-soon">
              <span>DEVELOPMENT PARTNER</span>
              <strong>Coming soon</strong>
            </div>
          </div>
        </section>
      </div>
      <div class="partner-organizer">
        <div class="partner-organizer__logo"><img src="/images/partners/leave-a-nest.png" alt="Leave a Nest" loading="lazy" /></div>
        <div>
          <p class="partner-card__role">ORGANIZER</p>
          <h3>株式会社リバネス</h3>
        </div>
      </div>
      <div class="partner-note">
        <p>LVNS SPACE PROJECTは、宇宙を起点とした新しい挑戦に取り組むパートナーを募集しています。</p>
        <a class="text-link" href="mailto:ask@space.lne.st">PARTNER WITH US <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="contact__overlay"></div>
    <div class="content-inner contact__inner">
      <p class="eyebrow eyebrow--light">GET IN TOUCH</p>
      <h2 class="section-title section-title--light" id="contact-title">CONTACT</h2>
      <p>お問い合わせ</p>
      <a class="contact__button" href="mailto:ask@space.lne.st">ask@space.lne.st <span>↗</span></a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { approachesEn } from '../../../data/approaches-en';
import type { ApproachPage } from '../../../data/approaches';

export function getStaticPaths() {
  return approachesEn.map((approach) => ({ params: { slug: approach.slug }, props: { approach } }));
}

type Props = { approach: ApproachPage };
const { approach } = Astro.props as Props;
const nextHref = approach.next ? `/en/approach/${approach.next.slug}/` : '/en/#approach';
---

<BaseLayout lang="en" title={`${approach.keyword} | ${approach.title} | LVNS SPACE PROJECT`} description={approach.catchphrase} image={approach.image}>
  <main class="approach-detail">
    <section class="approach-detail__hero section-gray" aria-labelledby="approach-detail-title"><div class="content-inner approach-detail__hero-inner"><div class="approach-detail__copy"><a class="back-link" href="/en/#approach">← ALL APPROACHES</a><p class="approach-detail__index">{approach.number} <span>/</span> {approach.keyword}</p><h1 id="approach-detail-title">{approach.title}</h1><h2>{approach.catchphrase}</h2><div class="approach-detail__lead">{approach.lead.map((paragraph) => <p>{paragraph}</p>)}<p class="approach-detail__emphasis"><strong>{approach.emphasis}</strong></p></div></div><figure class="approach-detail__visual"><img src={approach.image} alt={approach.imageAlt} loading="eager" /><figcaption>{approach.keyword} / LVNS SPACE PROJECT</figcaption></figure></div></section>
    <section class="approach-detail__process" aria-labelledby="process-title"><div class="content-inner"><p class="eyebrow">HOW WE PROCEED</p><h2 class="section-title" id="process-title">PROCESS</h2><ol class="approach-process">{approach.process.map((step, index) => <li class="approach-process__item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>)}</ol></div></section>
    <section class="approach-detail__examples section-gray" aria-labelledby="examples-title"><div class="content-inner"><p class="eyebrow">IN PRACTICE</p><h2 class="section-title" id="examples-title">{approach.examplesTitle}</h2><ul class="approach-examples">{approach.examples.map((example, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{example}</strong></li>)}</ul></div></section>
    <section class="approach-detail__closing" aria-label="Closing message"><div class="content-inner"><p>{approach.closing}</p>{approach.next ? <a class="approach-detail__next" href={nextHref}><span>NEXT APPROACH</span><strong>{approach.next.number} / {approach.next.keyword}</strong><em>{approach.next.title}</em><i aria-hidden="true">↗</i></a> : <div class="approach-detail__model"><span>LVNS SPACE PROJECT</span><strong>Discover engineering in space. Build industry on Earth.</strong><a href={nextHref}>ALL APPROACHES <i aria-hidden="true">↗</i></a></div>}</div></section>
  </main>
</BaseLayout>

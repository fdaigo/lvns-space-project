---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEnglishNews } from '../../../data/news-en';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout lang="en" title="News" description="The latest news from LVNS SPACE PROJECT">
  <section class="listing-page">
    <div class="content-inner">
      <header class="page-heading page-heading--compact"><p class="eyebrow">LVNS SPACE PROJECT</p><h1>NEWS</h1><p>Updates from the project</p></header>
      <div class="news-list">
        {posts.map((post) => {
          const translation = getEnglishNews(post);
          return <article class="news-list-item"><a href={`/en/news/${post.id}/`}><div class="news-list-item__image-wrap"><img src={post.data.heroImage} alt="" loading="lazy" /></div><div class="news-list-item__body"><div class="news-card__meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US')}</time>{translation.tags.map((tag) => <span>{tag}</span>)}</div><h2>{translation.title}</h2><p>{translation.description}</p><span class="text-link">READ MORE <span>↗</span></span></div></a></article>;
        })}
      </div>
    </div>
  </section>
</BaseLayout>

---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Locale } from '../utils/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  lang?: Locale;
}

const {
  title = 'LVNS SPACE PROJECT',
  description = '宇宙を使って、延長線上にない工学を発見する。',
  image = 'https://space.lne.st/wp-content/themes/lnest_space/images/top/fva@2x.jpg',
  type = 'website',
  lang = 'ja',
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const imageURL = new URL(image, siteOrigin);
const fullTitle = title === 'LVNS SPACE PROJECT' ? title : title + ' | LVNS SPACE PROJECT';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/images/brand/lvns-space-project-emblem.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@1,300;1,500&family=Noto+Sans+JP:wght@400;500;700&family=Open+Sans:ital,wght@1,500;1,600&display=swap" rel="stylesheet" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="LVNS SPACE PROJECT" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>

---
interface Props {
  lang?: 'ja' | 'en';
}

interface Partner {
  id: string;
  name: string;
  logo: string;
  category?: string;
  intro: string;
  involvement: string;
  website: string;
  lVenturesUrl?: string;
}

const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';

const partners: Partner[] = [
  {
    id: 'iddk',
    name: isEnglish ? 'IDDK Co., Ltd.' : '株式会社IDDK',
    logo: '/images/partners/iddk.jpg',
    category: isEnglish ? 'Operating Partner' : '運営パートナー',
    intro: isEnglish
      ? 'IDDK develops microscopy and observation systems for research, healthcare, and space applications.'
      : '顕微観察装置を軸に、研究・医療・宇宙分野で利用できる観察技術や実験システムを開発する企業です。',
    involvement: isEnglish
      ? 'As an operating partner, IDDK contributes to the space-experiment access foundation and the development of space-ready research equipment.'
      : '運営パートナーとして、宇宙実験のアクセス基盤構築と宇宙機器開発を担います。',
    website: 'https://iddk.co.jp/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/iddk/',
  },
  {
    id: 'spacenome',
    name: isEnglish ? 'SpaceNome Lab, Inc.' : '株式会社スペースノーム研究所',
    logo: '/images/partners/space-nome-lab.png',
    category: isEnglish ? 'Operating Partner' : '運営パートナー',
    intro: isEnglish
      ? 'SpaceNome Lab uses space as a research environment to develop new research themes and experimental systems.'
      : '宇宙環境を研究フィールドとして活用し、新しい研究テーマや実験システムの創出に取り組む研究所です。',
    involvement: isEnglish
      ? 'As an operating partner, SpaceNome Lab helps create research themes unique to space and connect findings to new value on Earth.'
      : '運営パートナーとして、宇宙ならではの研究テーマ創出と、成果を社会価値へつなぐ基準づくりを担います。',
    website: 'https://spacenome.jp/',
  },
  {
    id: 'elevation-space',
    name: isEnglish ? 'ElevationSpace Inc.' : '株式会社ElevationSpace',
    logo: '/images/partners/elevation-space.webp',
    intro: isEnglish
      ? 'ElevationSpace is developing spacecraft and in-orbit platforms that enable experiments in space and the return of their results to Earth.'
      : '宇宙機や軌道上実験プラットフォームの開発を通じ、宇宙での実験と成果の地上回収を目指す企業です。',
    involvement: isEnglish
      ? 'Listed here as a space-related company featured by L-VENTURES. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている宇宙関連企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://elevation-space.com/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/elevation-space/',
  },
  {
    id: 'solafune',
    name: isEnglish ? 'Solafune, Inc.' : '株式会社Solafune',
    logo: '/images/partners/solafune.webp',
    intro: isEnglish
      ? 'Solafune develops satellite imagery analysis and AI platforms to connect geospatial data with real-world challenges.'
      : '衛星画像解析やAIの基盤を通じて、衛星データと社会・産業の課題をつなぐ企業です。',
    involvement: isEnglish
      ? 'Listed here as a space-related company featured by L-VENTURES. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている宇宙関連企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://solafune.com/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/solafune/',
  },
  {
    id: 'sagri',
    name: isEnglish ? 'Sagri Co., Ltd.' : 'サグリ株式会社',
    logo: '/images/partners/sagri.webp',
    intro: isEnglish
      ? 'Sagri uses satellite data and AI to support agriculture, land management, and environmental decision-making.'
      : '衛星データとAIを活用し、農地把握や土壌分析、環境・地域課題の解決に取り組む企業です。',
    involvement: isEnglish
      ? 'Listed here as a space-related company featured by L-VENTURES. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている宇宙関連企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://sagri.tokyo/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/sagri/',
  },
  {
    id: 'tenchijin',
    name: isEnglish ? 'Tenchijin, Inc.' : '株式会社天地人',
    logo: '/images/partners/tenchijin.webp',
    intro: isEnglish
      ? 'Tenchijin combines satellite remote sensing and ground data to address geospatial challenges in infrastructure, agriculture, cities, and the environment.'
      : '衛星リモートセンシングと地上データを組み合わせ、インフラ、農業、都市、環境などの地理空間課題に取り組む企業です。',
    involvement: isEnglish
      ? 'Listed here as a space-related company featured by L-VENTURES. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている宇宙関連企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://tenchijin.co.jp/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/tenchijin/',
  },
  {
    id: 'plantex',
    name: isEnglish ? 'PLANTX Corp.' : '株式会社プランテックス',
    logo: 'https://www.j-startup.go.jp/en/startups/images/sta_175.png',
    intro: isEnglish
      ? 'PLANTX plans, builds, and supports the operation of artificial-light plant factories, and researches plant cultivation conditions.'
      : '人工光型植物工場の企画・設立・運営支援や、植物の栽培条件に関する研究などに取り組む企業です。',
    involvement: isEnglish
      ? 'Listed as an L-VENTURES company. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://www.plantx.co.jp/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/plantex/',
  },
  {
    id: 'integriculture',
    name: isEnglish ? 'Integriculture Inc.' : 'インテグリカルチャー株式会社',
    logo: 'https://prtimes.jp/data/corp/34252/ogp/c0d1119d0cfe0b4515180e083263ef31-73e9e2bf210eb3964ebca69d33266e14.png',
    intro: isEnglish
      ? 'Integriculture develops cell-cultivation technologies and production infrastructure for cellular agriculture, including food, cosmetics, and biomaterials.'
      : '細胞培養技術と生産インフラの開発を通じ、培養食品・化粧品・バイオ素材など細胞農業の実用化を目指す企業です。',
    involvement: isEnglish
      ? 'Listed as an L-VENTURES company. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://integriculture.com/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/integriculture/',
  },
  {
    id: 'japan-moss-factory',
    name: isEnglish ? 'Japan Moss Factory Co., Ltd.' : '株式会社ジャパンモスファクトリー',
    logo: 'https://jmf.co.jp/wp-content/uploads/2020/06/JMFlogo-300x49.png',
    intro: isEnglish
      ? 'Japan Moss Factory develops moss-based materials and products for environmental applications such as water-quality improvement and greening.'
      : '苔を素材として活用し、水質環境の改善や緑化など、環境分野への応用を目指す企業です。',
    involvement: isEnglish
      ? 'Listed as an L-VENTURES company. No separate partner role in LVNS SPACE PROJECT is currently designated.'
      : 'L-VENTURESに掲載されている企業として紹介しています。現時点で、LVNS SPACE PROJECTにおける個別のパートナー参画は設定されていません。',
    website: 'https://jmf.co.jp/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/japan-moss-factory/',
  },
  {
    id: 'outsense',
    name: isEnglish ? 'OUTSENSE Inc.' : '株式会社OUTSENSE',
    logo: '/images/partners/outsense.webp',
    category: isEnglish ? 'Operating Partner' : '運営パートナー',
    intro: isEnglish
      ? 'OUTSENSE applies origami engineering to structural challenges in space, architecture, and manufacturing.'
      : '折り工学を起点に、宇宙・建築・製造分野の構造課題に取り組む企業です。',
    involvement: isEnglish
      ? 'As an operating partner, OUTSENSE participates in the planning and operation of LVNS SPACE PROJECT.'
      : '運営パートナーとして、LVNS SPACE PROJECTの企画・運営に参画します。',
    website: 'https://outsense.jp/',
    lVenturesUrl: 'https://ventures.lne.st/ventures/outsense/',
  },
  {
    id: 'hasetora',
    name: isEnglish ? 'Hasetora Spinning Co., Ltd.' : '長谷虎紡績株式会社',
    logo: '/images/partners/hasetora-spinning.png',
    category: isEnglish ? 'Development Partner' : '開発パートナー',
    intro: isEnglish
      ? 'Founded in 1887, Hasetora Spinning is a textile manufacturer working across yarn, spinning, and fabric technologies.'
      : '1887年創業の紡績・繊維メーカー。繊維素材と紡績・撚糸・織編の技術を軸にものづくりに取り組んでいます。',
    involvement: isEnglish
      ? 'As a development partner, Hasetora is working with the project to develop smart textiles that function in the space environment.'
      : '開発パートナーとして、宇宙環境で機能するスマートテキスタイルの共同開発に取り組みます。',
    website: 'https://hasetora.co.jp/',
  },
];

const organizer: Partner = {
  id: 'leave-a-nest',
  name: isEnglish ? 'Leave a Nest Co., Ltd.' : '株式会社リバネス',
  logo: '/images/partners/leave-a-nest.png',
  category: isEnglish ? 'Organizer' : 'オーガナイザー',
  intro: isEnglish
    ? 'Leave a Nest supports science and technology research, development, and implementation in society by connecting researchers, companies, and institutions.'
    : '科学技術の研究開発と社会実装を支援し、研究者・企業・教育機関をつなぐ会社です。',
  involvement: isEnglish
    ? 'As the project organizer, Leave a Nest designs and coordinates the project and connects research themes, companies, researchers, and technologies.'
    : 'プロジェクトを企画・運営し、研究テーマ、企業、研究者、技術の連携を促進します。',
  website: 'https://lne.st/',
};

const labels = isEnglish
  ? {
      title: 'ECOSYSTEM',
      eyebrow: 'OUR ECOSYSTEM',
      lead: 'Let us build the future of space together.',
      context: 'This section introduces space-related companies connected with the Leave a Nest Group. Within LVNS SPACE PROJECT, designated partners collaborate to establish the research laboratory: Operating Partners lead technology development for its establishment, Development Partners create new space businesses, and Platform Partners connect space with Earth to expand our activities. The L-VENTURES tag identifies companies featured by L-VENTURES; it does not by itself indicate participation as a project partner.',
      details: 'Company profile',
      role: 'Project involvement',
      website: 'Visit official website',
      close: 'Close',
      venture: 'L-VENTURES',
    }
  : {
      title: 'ECOSYSTEM',
      eyebrow: 'OUR ECOSYSTEM',
      lead: '宇宙の未来を、ともにつくる。',
      context: 'リバネスグループとつながりのある、宇宙関連企業を紹介しています。LVNS SPACE PROJECTでは、研究所設立に向けた技術開発を担う運営パートナー、新たな宇宙事業を開発する開発パートナー、宇宙と地球をつなぐプラットフォームパートナーと連携し、活動を広げていきます。各社のタグで、本プロジェクトにおけるパートナーとしての立場をご確認いただけます。L-VENTURESタグは同サイトで紹介されている企業を示すもので、それだけで本プロジェクトへの参画を示すものではありません。',
      details: '会社紹介',
      role: 'プロジェクトでの関わり',
      website: '公式Webサイトを見る',
      close: '閉じる',
      venture: 'L-VENTURES',
    };
---

<section class="partner section-gray" id="partner" aria-labelledby="ecosystem-title">
  <div class="content-inner">
    <p class="eyebrow">{labels.eyebrow}</p>
    <h2 class="section-title" id="ecosystem-title">{labels.title}</h2>
    <p class="partner__lead">{labels.lead}</p>
    <p class="partner__context">{labels.context}</p>
    <div class="partner-grid partner-grid--unified">
      {partners.map((partner) => {
        const dialogId = `partner-detail-${partner.id}-${lang}`;
        return (
          <article class="partner-card">
            <div class="partner-card__tags" aria-label={isEnglish ? 'Company tags' : '企業タグ'}>
              {partner.category && <span class="partner-tag">{partner.category}</span>}
              {partner.lVenturesUrl && (
                <a class="partner-tag partner-tag--ventures" href={partner.lVenturesUrl} target="_blank" rel="noreferrer">
                  {labels.venture}
                </a>
              )}
            </div>
            <button class="partner-card__logo" type="button" aria-haspopup="dialog" aria-controls={dialogId} data-partner-dialog={dialogId}>
              <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
              <span class="sr-only">{isEnglish ? `View ${partner.name} profile` : `${partner.name}の紹介を表示`}</span>
            </button>
            <h3 class="partner-card__name">{partner.name}</h3>
            <dialog class="partner-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
              <div class="partner-dialog__panel" lang={isEnglish ? 'en' : 'ja'}>
                <button class="partner-dialog__close" type="button" aria-label={labels.close} data-partner-close>×</button>
                <p class="eyebrow">{labels.details}</p>
                <h3 id={`${dialogId}-title`}>{partner.name}</h3>
                <p class="partner-dialog__copy">{partner.intro}</p>
                <h4>{labels.role}</h4>
                <p class="partner-dialog__copy">{partner.involvement}</p>
                <a class="partner-dialog__link" href={partner.website} target="_blank" rel="noreferrer">
                  {labels.website} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </dialog>
          </article>
        );
      })}
    </div>
    <section class="partner-organizer" aria-labelledby={`organizer-name-${lang}`}>
      <span class="partner-tag partner-organizer__tag">{organizer.category}</span>
      <button class="partner-organizer__logo" type="button" aria-haspopup="dialog" aria-controls={`organizer-detail-${lang}`} data-partner-dialog={`organizer-detail-${lang}`}>
        <img src={organizer.logo} alt={organizer.name} loading="lazy" decoding="async" />
        <span class="sr-only">{isEnglish ? `View ${organizer.name} profile` : `${organizer.name}の紹介を表示`}</span>
      </button>
      <h3 class="partner-organizer__name" id={`organizer-name-${lang}`}>{organizer.name}</h3>
      <dialog class="partner-dialog" id={`organizer-detail-${lang}`} aria-labelledby={`organizer-detail-title-${lang}`}>
        <div class="partner-dialog__panel" lang={isEnglish ? 'en' : 'ja'}>
          <button class="partner-dialog__close" type="button" aria-label={labels.close} data-partner-close>×</button>
          <p class="eyebrow">{labels.details}</p>
          <h3 id={`organizer-detail-title-${lang}`}>{organizer.name}</h3>
          <p class="partner-dialog__copy">{organizer.intro}</p>
          <h4>{labels.role}</h4>
          <p class="partner-dialog__copy">{organizer.involvement}</p>
          <a class="partner-dialog__link" href={organizer.website} target="_blank" rel="noreferrer">
            {labels.website} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </dialog>
    </section>
    <div class="partner-note">
      <p>{isEnglish ? 'LVNS SPACE PROJECT welcomes partners who want to create new possibilities through research in space.' : 'LVNS SPACE PROJECTは、宇宙を起点とした新しい挑戦に取り組むパートナーを募集しています。'}</p>
      <a class="text-link" href="mailto:ask@space.lne.st">PARTNER WITH US <span>↗</span></a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-partner-dialog]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.partnerDialog ?? '') as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('.partner-dialog').forEach((dialog) => {
    dialog.querySelector('[data-partner-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

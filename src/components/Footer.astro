---
import type { Locale } from '../utils/i18n';

const { lang = 'ja' } = Astro.props as { lang?: Locale };
const isEnglish = lang === 'en';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <a class="site-logo site-logo--footer" href={isEnglish ? '/en/' : '/'} aria-label="LVNS SPACE PROJECT home">
        <img src="https://space.lne.st/wp-content/themes/lnest_space/images/common/title__logo.png?v=1.2" alt="LVNS SPACE PROJECT" width="440" height="56" loading="lazy" />
      </a>
      <p class="footer-organizer">{isEnglish ? 'Organized by Leave a Nest' : 'Organized by Leave a Nest'}</p>
    </div>
    <div class="footer-meta">
      <p>{isEnglish ? 'Leave a Nest Co., Ltd.' : '株式会社リバネス'}</p>
      <p>{isEnglish ? 'Iidabashi Miyuki Building 5F, 1-4 Shimomiyabi-cho, Shinjuku-ku, Tokyo' : '東京都新宿区下宮比町1-4 飯田橋御幸ビル5階'}</p>
      <small>&copy; LVNS SPACE PROJECT</small>
    </div>
  </div>
</footer>
